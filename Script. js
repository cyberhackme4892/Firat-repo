/* Simple Pong game
   - Left paddle: mouse + arrow keys
   - Right paddle: simple AI
   - Ball: bounces on walls and paddles
   - Scoreboard and reset on score
*/

const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');

const W = canvas.width;
const H = canvas.height;

// Paddle properties
const PADDLE_WIDTH = 12;
const PADDLE_HEIGHT = 100;
const PADDING = 12;
const PLAYER_X = PADDING;
const CPU_X = W - PADDLE_WIDTH - PADDING;
const PADDLE_SPEED = 6;

// Ball properties
let ballRadius = 8;
let ball = { x: W / 2, y: H / 2, vx: 5, vy: 2, speed: 6 };

// Scores
let leftScore = 0;
let rightScore = 0;

// Paddles
let leftPaddle = { x: PLAYER_X, y: H / 2 - PADDLE_HEIGHT / 2, w: PADDLE_WIDTH, h: PADDLE_HEIGHT };
let rightPaddle = { x: CPU_X, y: H / 2 - PADDLE_HEIGHT / 2, w: PADDLE_WIDTH, h: PADDLE_HEIGHT };

// Input state
let keys = { ArrowUp: false, ArrowDown: false };
let paused = false;

const leftScoreEl = document.getElementById('leftScore');
const rightScoreEl = document.getElementById('rightScore');

function resetBall(direction = (Math.random() > 0.5 ? 1 : -1)) {
  ball.x = W / 2;
  ball.y = H / 2;
  ball.speed = 6;
  // give a slightly random launch angle
  const angle = (Math.random() * 0.6 - 0.3); // -0.3..0.3 radians
  ball.vx = direction * ball.speed * Math.cos(angle);
  ball.vy = ball.speed * Math.sin(angle);
}

function clamp(v, a, b) {
  return Math.max(a, Math.min(b, v));
}

function drawNet() {
  ctx.fillStyle = 'rgba(255,255,255,0.06)';
  const step = 18;
  for (let y = 0; y < H; y += step) {
    ctx.fillRect(W/2 - 1, y + 6, 2, step/2);
  }
}

function draw() {
  // background
  ctx.clearRect(0, 0, W, H);

  // net
  drawNet();

  // paddles
  ctx.fillStyle = '#00e6a8';
  ctx.fillRect(leftPaddle.x, leftPaddle.y, leftPaddle.w, leftPaddle.h);
  ctx.fillStyle = '#fff';
  ctx.fillRect(rightPaddle.x, rightPaddle.y, rightPaddle.w, rightPaddle.h);

  // ball
  ctx.beginPath();
  ctx.fillStyle = '#ffd166';
  ctx.arc(ball.x, ball.y, ballRadius, 0, Math.PI * 2);
  ctx.fill();

  // scores are in DOM; no need to draw here
}

function update() {
  if (paused) return;

  // Move left paddle from keys
  if (keys.ArrowUp) leftPaddle.y -= PADDLE_SPEED;
  if (keys.ArrowDown) leftPaddle.y += PADDLE_SPEED;

  // Keep left paddle inside
  leftPaddle.y = clamp(leftPaddle.y, 0, H - leftPaddle.h);

  // Basic AI for right paddle: follow ball with limited speed
  const centerBall = ball.y;
  const centerPaddle = rightPaddle.y + rightPaddle.h / 2;
  const aiSpeed = 4.2; // lower -> easier AI
  if (centerBall < centerPaddle - 4) {
    rightPaddle.y -= aiSpeed;
  } else if (centerBall > centerPaddle + 4) {
    rightPaddle.y += aiSpeed;
  }
  rightPaddle.y = clamp(rightPaddle.y, 0, H - rightPaddle.h);

  // Move ball
  ball.x += ball.vx;
  ball.y += ball.vy;

  // Wall collision (top/bottom)
  if (ball.y - ballRadius <= 0) {
    ball.y = ballRadius;
    ball.vy = -ball.vy;
  } else if (ball.y + ballRadius >= H) {
    ball.y = H - ballRadius;
    ball.vy = -ball.vy;
  }

  // Paddle collisions
  // Left paddle
  if (ball.x - ballRadius <= leftPaddle.x + leftPaddle.w) {
    if (ball.y >= leftPaddle.y && ball.y <= leftPaddle.y + leftPaddle.h) {
      // collision
      ball.x = leftPaddle.x + leftPaddle.w + ballRadius; // avoid sticking
      reflectFromPaddle(leftPaddle, 1);
    }
  }

  // Right paddle
  if (ball.x + ballRadius >= rightPaddle.x) {
    if (ball.y >= rightPaddle.y && ball.y <= rightPaddle.y + rightPaddle.h) {
      // collision
      ball.x = rightPaddle.x - ballRadius;
      reflectFromPaddle(rightPaddle, -1);
    }
  }

  // Scoring
  if (ball.x < 0) {
    // right player scores
    rightScore++;
    rightScoreEl.textContent = rightScore;
    paused = true;
    setTimeout(() => { resetBall(-1); paused = false; }, 800);
  } else if (ball.x > W) {
    // left player scores
    leftScore++;
    leftScoreEl.textContent = leftScore;
    paused = true;
    setTimeout(() => { resetBall(1); paused = false; }, 800);
  }
}

function reflectFromPaddle(paddle, direction) {
  // direction: 1 if ball now going right (hit left paddle), -1 if ball now going left (hit right paddle)
  // compute hit relative position [-1 .. 1]
  const relativeY = (ball.y - (paddle.y + paddle.h / 2)) / (paddle.h / 2);
  const maxBounceAngle = Math.PI / 3; // ~60 degrees
  const bounceAngle = relativeY * maxBounceAngle;

  // increase speed slightly on hits
  ball.speed = Math.min(14, ball.speed * 1.03);

  ball.vx = direction * ball.speed * Math.cos(bounceAngle);
  ball.vy = ball.speed * Math.sin(bounceAngle);
}

function loop() {
  update();
  draw();
  requestAnimationFrame(loop);
}

// Input: mouse
canvas.addEventListener('mousemove', (e) => {
  const rect = canvas.getBoundingClientRect();
  const y = e.clientY - rect.top;
  // center paddle around mouse
  leftPaddle.y = clamp(y - leftPaddle.h / 2, 0, H - leftPaddle.h);
});

// Input: keys
window.addEventListener('keydown', (e) => {
  if (e.code === 'Space') {
    paused = !paused;
    e.preventDefault();
    return;
  }
  if (e.code === 'ArrowUp' || e.code === 'ArrowDown') {
    keys[e.code] = true;
    e.preventDefault();
  }
});

window.addEventListener('keyup', (e) => {
  if (e.code === 'ArrowUp' || e.code === 'ArrowDown') {
    keys[e.code] = false;
    e.preventDefault();
  }
});

// Prevent arrow keys from scrolling page when focused on canvas
window.addEventListener('keydown', (e) => {
  if (['ArrowUp','ArrowDown','Space'].includes(e.code)) e.preventDefault();
}, { passive: false });

// initial setup
leftScoreEl.textContent = leftScore;
rightScoreEl.textContent = rightScore;
resetBall();
requestAnimationFrame(loop);
