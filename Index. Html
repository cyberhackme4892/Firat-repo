<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Simple Pong</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <div class="container">
    <h1>Simple Pong</h1>
    <div id="scoreboard">
      <span id="leftScore">0</span>
      <span class="divider">—</span>
      <span id="rightScore">0</span>
    </div>
    <canvas id="game" width="800" height="500"></canvas>
    <div class="controls">
      <p>Controls: Move mouse over the canvas or use ↑ / ↓ arrows to move the left paddle. Press Space to pause / resume.</p>
    </div>
    <div class="footer">
      <small>Ball/paddle collisions, wall bouncing, scoring, and simple AI for right paddle are included.</small>
    </div>
  </div>

  <script src="script.js"></script>
</body>
</html>
