:root{
  --bg: #0b1221;
  --panel: #0e1724;
  --accent: #00e6a8;
  --text: #dbeafe;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,"Helvetica Neue",Arial;background:var(--bg);color:var(--text)}
.container{max-width:920px;margin:28px auto;padding:18px;background:linear-gradient(180deg, rgba(255,255,255,0.02), transparent);border-radius:10px;box-shadow:0 6px 30px rgba(2,6,23,0.6);text-align:center}
h1{margin:0 0 10px;font-weight:600;color:var(--accent)}
#scoreboard{font-size:36px;margin-bottom:12px;display:flex;justify-content:center;align-items:center;gap:18px}
#scoreboard .divider{color:rgba(255,255,255,0.36)}
canvas{display:block;margin:0 auto;background:var(--panel);border-radius:6px;border:2px solid rgba(255,255,255,0.03);cursor:default;box-shadow:inset 0 0 50px rgba(0,0,0,0.6)}
.controls{margin-top:12px;color:rgba(219,234,254,0.8)}
.footer{margin-top:8px;color:rgba(219,234,254,0.5)}
